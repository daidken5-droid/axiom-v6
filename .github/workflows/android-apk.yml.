
name: Build AXIOM OMEGA Android APK

on:
  workflow_dispatch:

  push:
    paths:
      - "**"

permissions:
  contents: read

concurrency:
  group: axiom-android-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build-debug-apk:
    name: Build AXIOM APK
    runs-on: ubuntu-24.04
    timeout-minutes: 45

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Locate AXIOM project
        id: locate
        shell: bash
        run: |
          set -euo pipefail

          ROOT=""

          if [[ -f server/requirements-dev.txt && -f android-app/settings.gradle.kts ]]; then
            ROOT="."
          else
            while IFS= read -r FILE; do
              CANDIDATE="${FILE%/server/requirements-dev.txt}"
              CANDIDATE="${CANDIDATE#./}"

              [[ -n "$CANDIDATE" ]] || CANDIDATE="."

              if [[ -f "$CANDIDATE/android-app/settings.gradle.kts" ]]; then
                ROOT="$CANDIDATE"
                break
              fi
            done < <(find . -type f -path "*/server/requirements-dev.txt" -not -path "./.git/*")
          fi

          if [[ -z "$ROOT" ]]; then
            echo "AXIOM project not found!"
            find . -maxdepth 4 -type f | head -200
            exit 1
          fi

          echo "project_root=$ROOT" >> "$GITHUB_OUTPUT"
          echo "Found AXIOM at: $ROOT"

      - name: Set up Java
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: |
            ${{ steps.locate.outputs.project_root }}/server/requirements.txt
            ${{ steps.locate.outputs.project_root }}/server/requirements-dev.txt

      - name: Set up Android SDK
        uses: android-actions/setup-android@v4

      - name: Install Android SDK
        run: |
          sdkmanager --install \
            "platforms;android-35" \
            "build-tools;35.0.0"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "8.11.1"
          cache-provider: basic

      - name: Install Python dependencies and run tests
        env:
          ROOT: ${{ steps.locate.outputs.project_root }}
        run: |
          set -euo pipefail

          python -m pip install \
            -r "$ROOT/server/requirements-dev.txt"

          python -m pytest -q "$ROOT/server/tests"

      - name: Build AXIOM APK
        env:
          ROOT: ${{ steps.locate.outputs.project_root }}
        run: |
          set -euo pipefail

          gradle --no-daemon \
            --stacktrace \
            -p "$ROOT/android-app" \
            clean assembleDebug

      - name: Verify APK
        env:
          ROOT: ${{ steps.locate.outputs.project_root }}
        run: |
          set -euo pipefail

          APK="$ROOT/android-app/app/build/outputs/apk/debug/app-debug.apk"

          test -s "$APK"

          "$ANDROID_HOME/build-tools/35.0.0/apksigner" \
            verify --verbose "$APK"

          APP_ID="$(apkanalyzer manifest application-id "$APK")"

          echo "Application ID: $APP_ID"

          test "$APP_ID" = "cz.axiom.app.dev"

          unzip -l "$APK" | grep 'lib/arm64-v8a/libaxiom.so'

          sha256sum "$APK" | tee "$APK.sha256"

      - name: Upload APK
        uses: actions/upload-artifact@v7
        with:
          name: AXIOM-OMEGA-5.0-Beta-5-APK
          path: |
            ${{ steps.locate.outputs.project_root }}/android-app/app/build/outputs/apk/debug/app-debug.apk
            ${{ steps.locate.outputs.project_root }}/android-app/app/build/outputs/apk/debug/app-debug.apk.sha256
          if-no-files-found: error
          retention-days: 14
